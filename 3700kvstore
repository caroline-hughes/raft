#!/usr/bin/env python3

import argparse, socket, time, json, select, random 
import enum

BROADCAST = "FFFF"
HEARTBEAT_PERIOD = .140  # leader should send heartbeat every 140ms
REPLICAS = ["0000", "0001", "0002", "0003", "0004"]

class State(enum.Enum):
    FOLLOWER = 0
    CANDIDATE = 1
    LEADER = 2

class Entry:
    term = None
    key = None
    value = None 
    MID = None 
    client = None
    committed = False
    successes = 0

    def __init__(self, term, key, value, MID, client):
        self.term = term
        self.key = key
        self.value = value
        self.MID = MID
        self.client = client

    def commit(self):
        self.committed = True

    def increment_successes(self):
        self.successes += 1

class Replica:
    state = State.FOLLOWER  # current state of this replica
    term = 0                # current term
    leader_id = BROADCAST   # current leader of the cluster

    log = []      # list of triples: [term, k, v]
    detailed_log = []      # list of triples: [term, k, v]

    data = {}     # dict of committed (k, v) pairs
    
    # if follower, timer tracks last time we heard from leader
    timer_start = 0  

    # candidate fields:
    my_voters = []  # our votees

    # follower fields:
    voted = False     # flag for if weve voted in the election yet
    TIMEOUT = None    # our timeout threshold in ms
    # lastApplied = -1           # points to the entry in log that was last committed

    # leader fields:
    curr_k_v = [None, None]    # the current (k,v) pair to be put()

    # awaiting_majority = False  # flag for whether this put() is complete
    successes = 0              # number of followers who agree to the current put
    # puts_queue = []            # the list of the next client put()s
    
    commitIndex = -1           # index in log where everything before should be committed, if not already

    nextIndex = [0,0,0,0,0] 

    # leaders_next_index_to_commit = 0

    timers = [0, 0, 0, 0, 0]
    

    def __init__(self, port, id, others):
        self.port = port
        self.id = id
        self.others = others

        self.socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.socket.bind(('localhost', 0))

        print("Replica %s starting up" % self.id, flush=True)
        hello = { "src": self.id, "dst": BROADCAST, "leader": BROADCAST, "type": "hello" }
        #print('I AM: ', int(self.id))
        self.send(hello)

        # assign timeout within 150–300ms
        self.TIMEOUT = random.randrange(150, 300) / 1000 
        self.timer_start = time.time() 

    def send(self, message, shouldprint=False):
        print("Sent message: %s" % message, flush=True)
        self.socket.sendto(json.dumps(message).encode('utf-8'), ('localhost', self.port))


    ##################################################################################################
    # VOTING Logic

    # received a RequestVote RPC
    def got_request_vote(self, json_msg):
        self.leader_id = BROADCAST
        src = json_msg['src']
        valid = True

        # 1. Reply false if term < currentTerm (§5.1)
        if json_msg['term'] < self.term:
            valid = False
        
        # 2. Cannot vote twice (§5.2)
        if self.voted:
            valid = False

        # 3. If candidate’s log is at least as up-to-date as receiver’s log, grant vote (§5.4)
        # ie. it is guaranteed that the election winner will have most up to date logs
        src_last_i = json_msg['last_i'] 
        src_last_term = json_msg['last_term']
        
        last_i = len(self.log) - 1
        last_term = -1 if self.log == [] else self.log[last_i][0]

        if src_last_i < last_i or src_last_term < last_term:
            valid = False

        votemsg = { 
            "src": self.id, 
            "dst": src,
            "leader": BROADCAST, 
            "type": "vote", 
            "vote": 'true' if valid else 'false',
            "cand_id": src, 
        }

        self.send(votemsg)
        self.voted = valid
        self.timer_start = time.time()

     # if candidate, parse the vote we received
    def got_vote(self, msg):
        if self.state == State.LEADER:
            return # already leader, ignore
        voter = msg['src']

        if msg['vote'] == 'true' and (voter not in self.my_voters):
            self.my_voters.append(voter)
            # if we have a majority, we are now the leader
            if len(self.my_voters) >= 2:
                print('\n\n NEW LEADER:', self.id)
                self.state = State.LEADER
                self.leader_id = self.id
                self.voted = False
                self.my_voters = []
                now = time.time()
                ll = len(self.log)
                self.timers = [now,now,now,now,now]
                self.nextIndex = [ll,ll,ll,ll,ll]

                # start heartbeat as new leader
                self.ae_loop(heartbeat = True)

        # if we got rejected, its possible our term was out of date
        elif msg['vote'] == 'false' and msg['term'] > self.term:
            self.term = msg['term']


    # if not the leader, monitor leader timeout
    def check_timeout(self):
        if time.time() > (self.timer_start + self.TIMEOUT) and self.state == State.FOLLOWER:
            print('\n\n LEADER DIED')
        
        elif time.time() > (self.timer_start + self.TIMEOUT) and self.state == State.CANDIDATE:
            print('\n\n ELECTION TIMED OUT')

        else:
            return

        self.term += 1
        print(str(self.id) + ' is sending RequestVote')

        # become a candidate, increment our term, send RequestVote
        self.leader_id = BROADCAST
        self.state = State.CANDIDATE

        last_i = len(self.log) - 1
        last_term = -1 if self.log == [] else self.log[last_i][0]
        rv = { 
            "src": self.id, 
            "dst": BROADCAST, 
            "leader": BROADCAST,
            "type": "rv", 
            "term": self.term, 
            "last_i": last_i,         # index of last log entry
            "last_term": last_term    # term of that entry
        }
        self.voted = True
        self.my_voters = [self.id]
        self.TIMEOUT = random.randrange(150, 300) / 1000 
        self.timer_start = time.time() 
        self.send(rv)
        

    # if leader, monitor heartbeat
    def check_heartbeat(self):
        for i, t in enumerate(self.timers):
            id = "000" + str(i)
            if id != self.id and (time.time() > (t + HEARTBEAT_PERIOD)):
                # print('\nSENDING HEARTBEAT TO', id)
                self.send_append_entries(heartbeat = True, follower_id = id)


    ##################################################################################################
    # AppendEntries Logic

    def send_append_entries(self, heartbeat = False, follower_id = None):
        nextI = self.nextIndex[int(follower_id)]
        prev_log_i = nextI - 1
        prev_log_term = -1 if (len(self.log) <= 1) else self.log[prev_log_i][0] 

        # if (prev_log_term > -1):
        #     print('ok so')
        #     print(self.log)
    
        # here are the entries you should append to your log
        entries = [] if self.log == [] else self.log[nextI:]         

        ae = {
            "src": self.id, 
            "dst": follower_id, 
            "leader": self.id,
            "type": "ae",
            "term": self.term,
            "prev_log_i": prev_log_i,
            "prev_log_term": prev_log_term,
            "entries": [] if heartbeat else entries, 
            "commitIndex": self.commitIndex # everything thru commitIndex should comm to your database
            }   
        shouldp = False if heartbeat else True
        self.send(ae, shouldprint=shouldp)
        self.timers[int(follower_id)] = time.time()

    # we received an AE rpc from leader
    def got_append_entries(self, msg):
        self.timer_start = time.time()
        leader = msg["src"]
        entries = msg["entries"]
        leader_commitIndex = int(msg["commitIndex"])
        leader_term = int(msg["term"])

        # if this is a new leader
        if self.leader_id == BROADCAST or self.leader_id != leader:
            self.state = State.FOLLOWER
            self.leader_id = leader
            self.voted = False
            self.my_voters = []
            self.term = leader_term # i think we need to do this?

        # if not just a heartbeat
        if entries != []:
            prev_log_i = int(msg["prev_log_i"])
            prev_log_term = int(msg["prev_log_term"])

            # 1. Reply false if term < currentTerm (§5.1)
            if leader_term < self.term:
                self.reply_to_ae(msg, False)
                return

            # 2. Reply false if log doesn’t contain an entry at prevLogIndex whose term matches prevLogTerm (§5.3)
            if prev_log_i != -1 and (prev_log_i <= len(self.log) - 1):
                if self.log[prev_log_i][0] != prev_log_term:
                    self.reply_to_ae(msg, False)
                    return

            for n, entry_to_add in enumerate(entries, start=1):
                t = entry_to_add[0]
                proposed_index = prev_log_i + n

                # 3. If an existing e conflicts with a new one (same index but different terms), delete the existing entry and all that follow it (§5.3)
                if (proposed_index <= (len(self.log) - 1)) and (self.log[proposed_index][0] != t):
                    self.log = self.log[0:proposed_index]

                # 4. Append the new entry
                self.log.append(entry_to_add)

            # 5. If leaderCommit > commitIndex, set commitIndex = min(leaderCommit, index of last new entry)
            self.update_follower_db(leader_commitIndex)

            self.reply_to_ae(msg, True)


    def update_follower_db(self, leader_commitIndex):
        if self.state != State.FOLLOWER:
            return
        # if we can commit some stuff in our follower log
        if leader_commitIndex > self.commitIndex:
            for i in range(self.commitIndex, leader_commitIndex + 1):
                entry_to_commit = self.log[i]
                k = entry_to_commit[1]
                v = entry_to_commit[2]
                self.data[k] = v
                print('\nFOLLOWER: I JUST COMMITTED TO MY DB')
        
        self.commitIndex = min(leader_commitIndex, len(self.log))



    def reply_to_ae(self, msg, valid):
        ae_res = { 
            "src": self.id, 
            "dst": self.leader_id, 
            "leader": self.leader_id,
            "type": "ae_res",
            "term": self.term,
            "nextI": len(self.log),
            "success": "true" if valid else "false"
            }
        self.send(ae_res)

    # handle success or failure response from follower after an appendEntries RPC
    def got_ae_res(self, msg):
        f_id = int(msg["src"])
        success = True if msg["success"] == "true" else False
        newNextIndex = int(msg['nextI']) # the follower tells us what their next index is now. this is the len(their log)
        if success: # and newNextIndex > self.leaders_next_index_to_commit:
            # update the nextIndex on file for this follower. Next time well only send them entries theyve not yet committed.
            if newNextIndex > self.nextIndex[f_id]:
                self.nextIndex[f_id] = newNextIndex
                print('NEW NEXTINDEXES: ', self.nextIndex)
            
            if newNextIndex > self.commitIndex:
                self.successes += 1
                if self.successes >= 2:
                    print('log is', self.log)
                    print('\n\nGOT MAJORITY, committing.')
                    print('self.commitIndex:', self.commitIndex)
                    i_to_commit = self.commitIndex + 1
                    # grab the most recent entry, commit to data dict
                    entry = self.log[i_to_commit]
                    self.data[entry[1]] = entry[2] 
                    detailed_entry: Entry = self.detailed_log[i_to_commit]
                    detailed_entry.successes += 1
                    detailed_entry.committed = True

                    # tell the client we've committed their put()
                    put_ok = {
                        "src": self.id, 
                        "dst": detailed_entry.client,
                        "leader": self.id, 
                        "type": "ok", 
                        "MID": detailed_entry.MID,
                        }
                    self.send(put_ok)

                    #print("\n\nput() for %s was ok" % self.curr_mid, flush=True)
                    # self.leaders_next_index_to_commit += 1
                    self.commitIndex += 1 # ???
                    self.successes = 0  # reset successes counter

        # else decrement nextIndex and try again
        else:
            self.nextIndex[f_id] = self.nextIndex[f_id] - 1
            self.send_append_entries(heartbeat=False, follower_id=f_id)

    ##################################################################################################
    # PUT AND GET LOGIC:

    def handle_leader_command(self, msg):
        if msg['leader'] != self.leader_id:
            self.send_redirect(msg)
        elif msg["type"] == "get":
            self.handle_get(msg)
        elif msg["type"] == "put":
            self.handle_put(msg)
        else:
            print("invalid message")
        
    # leader logic for informing replicas about put() from client
    def handle_put(self, msg):
        # if non duplicate put()
        print('\n\n LEADER: GOT PUT()')
        k = msg["key"]
        v = msg["value"]
        if [k, v] != self.curr_k_v:
            # 1. add the new entry to our log
            entry = [self.term, k, v]
            self.log.append(entry)

            # 1. add the new entry to our detailed log, along with info for how to respond eventually
            detailed_entry = Entry(self.term, k, v, msg['MID'], msg['src'])
            self.detailed_log.append(detailed_entry)

            self.curr_k_v = [k, v] # necessary?

            self.ae_loop()
        
    def ae_loop(self, heartbeat = False):
        # print('ae_loop')
        # check which followers need new entries, based on their nextIndex
        for str_id in REPLICAS:
            if str_id != self.id:
                int_id = int(str_id)
                if len(self.log) > self.nextIndex[int_id]:
                    self.send_append_entries(heartbeat, str_id)
                    self.timers[int_id] = time.time()

    # leader logic for replying to a get()
    def handle_get(self, msg):
        val = self.data[msg["key"]] if msg["key"] in self.data.keys() else ""
        get_res = {
            "src": self.id, 
            "dst": msg["src"], 
            "leader": self.id, 
            "type": "ok", 
            "MID": msg["MID"],
            "value": val
            }
        self.send(get_res)

    def send_redirect(self, msg):
        # print('\n REDIRECT. TELLING CLIENT ABOUT LEADER')
        redirect = {
            "src": self.id, 
            "dst": msg["src"],
            "leader": self.leader_id,
            "type": "redirect",
            "MID": msg['MID']
            }
        self.send(redirect)

    ##################################################################################################

    def run(self):
        while True:
            incoming, outgoing, exceptional = select.select([self.socket], [self.socket], [self.socket])
            for reader in incoming:
                if reader is self.socket:
                    # recv
                    data, addr = self.socket.recvfrom(65535)
                    msg = json.loads(data.decode('utf-8'))
                    # print("Received message '%s'" % (data.decode('utf-8'),), flush=True)
                    mtype = msg['type']
                    src = msg['src']

                    # Does this logic also go within here? it involves send()s ....

                    # handle a requestVote RPC
                    if mtype == "rv":
                        self.got_request_vote(msg)

                    # handle a vote
                    if mtype == "vote" and self.state == State.CANDIDATE:
                        self.got_vote(msg)

                    # handle an appendEntries RPC
                    if mtype == 'ae':
                        self.got_append_entries(msg)                    

                    # handle a follower response to AppendEntries
                    if mtype == 'ae_res' and self.state == State.LEADER:
                        self.got_ae_res(msg)

                    # handle client put/get
                    if mtype == 'put' or mtype == 'get':
                        self.handle_leader_command(msg)

            for writer in outgoing:
                if writer is self.socket:
                    # Check for various timeouts, depending on state
                    if self.state != State.LEADER:
                        self.check_timeout()
                    if self.state == State.LEADER:
                        self.check_heartbeat()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='run a key-value store')
    parser.add_argument('port', type=int, help="Port number to communicate")
    parser.add_argument('id', type=str, help="ID of this replica")
    parser.add_argument('others', metavar='others', type=str, nargs='+', help="IDs of other replicas")
    args = parser.parse_args()
    replica = Replica(args.port, args.id, args.others)
    replica.run()


