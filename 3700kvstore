#!/usr/bin/env python3

import argparse, socket, time, json, select, random
import enum

BROADCAST = "FFFF"
HEARTBEAT_PERIOD = .140  # leader should send heartbeat every 140ms
REPLICAS = ["0000", "0001", "0002", "0003", "0004"]

class State(enum.Enum):
    FOLLOWER = 0
    CANDIDATE = 1
    LEADER = 2

class Replica:
    # universal fields
    state = State.FOLLOWER      # current state of this replica
    term = 0                    # current term
    leader_id = BROADCAST       # current leader of the cluster

    log = []                    # list of triples: [term, k, v]
    data = {}                   # dict of committed (k, v) pairs
    timer_start = 0
    
    election_queue = []         # client messages received during an election period to be serviced later
    election = False

    commitIndex = -1            # the index of the biggest committed entry in log
    nextIndex = [0, 0, 0, 0, 0] 
    timers = [0, 0, 0, 0, 0]

    # follower fields:
    voted = False               # flag for if weve voted in the election yet
    TIMEOUT = None              # our timeout threshold in ms

    # candidate fields:
    my_voters = []              # our votees, including ourself

    # leader fields:
    curr_client = None         # the current client being serviced by the put()
    curr_mid = None            # the current message id being serviced by the put()
    curr_k_v = [None, None]    # the current (k,v) pair to be put()
    awaiting_majority = False  # flag for whether this put() is awaiting quorum
    successes = 0              # number of followers who've agree to the current put
    puts_queue = []            # the queue of future client put()s
    put_timer = 0
    curr_put = None
    
    ##################################################################################################
    def __init__(self, port, id, others):
        self.port = port
        self.id = id
        self.others = others

        self.socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.socket.bind(('localhost', 0))

        # print("Replica %s starting up" % self.id, flush=True)
        hello = { "src": self.id, "dst": BROADCAST, "leader": BROADCAST, "type": "hello" }
        self.send(hello)

        # assign timeout within 150–300ms
        self.TIMEOUT = random.randrange(150, 300) / 1000 
        self.timer_start = time.time() 

    ##################################################################################################
    # CORE LOGIC:

    def run(self):
        while True:
            incoming, outgoing, exceptional = select.select([self.socket], [self.socket], [self.socket])
            for reader in incoming:
                if reader is self.socket:
                    data, addr = self.socket.recvfrom(65535)
                    msg = json.loads(data.decode('utf-8'))
                    # print("Received message '%s'" % (data.decode('utf-8'),), flush=True)
                    mtype = msg['type']

                    # handle a requestVote RPC
                    if mtype == "rv":
                        self.got_request_vote(msg)

                    # handle a response to your candidate requestVote RPC
                    if mtype == "vote" and self.state == State.CANDIDATE:
                        self.got_vote(msg)

                    # handle an appendEntries RPC
                    if mtype == 'ae':
                        self.got_append_entries(msg)

                    # handle a follower response to AppendEntries
                    if mtype == 'ae_res' and self.state == State.LEADER:
                        self.got_ae_res(msg)

                    # handle client put/get
                    if mtype == 'put' or mtype == 'get':
                        if self.election:
                            self.election_queue.append(msg)
                        else:
                            self.handle_leader_command(msg)

            for writer in outgoing:
                if writer is self.socket:
                    # Check for various timeouts, depending on state
                    if self.state != State.LEADER:
                        self.check_timeout()
                    if self.state == State.LEADER:
                        self.check_heartbeat()
                        if self.awaiting_majority and time.time() > (self.put_timer + 50/1000):
                            self.ae_loop(heartbeat=False)
                            self.put_timer = time.time()

    def send(self, message):
        # print("Sent message: %s" % message, flush=True)
        self.socket.sendto(json.dumps(message).encode('utf-8'), ('localhost', self.port))

    ##################################################################################################
    # ELECTION LOGIC

    # received a RequestVote RPC
    def got_request_vote(self, json_msg):
        if self.state != State.LEADER:
            src = json_msg['src']
            valid = True

            # 1. Reply false if term < currentTerm (§5.1)
            if json_msg['term'] <= self.term:
                valid = False

            # 2. Cannot vote twice (§5.2)
            if self.voted:
                valid = False

            # 3. If candidate’s log is at least as up-to-date as receiver’s log, grant vote (§5.4)
            # ie. it is guaranteed that the election winner will have most up to date logs
            src_last_i = int(json_msg['last_i'])
            src_last_term = int(json_msg['last_term'])

            last_i = len(self.log) - 1
            last_term = -1 if self.log == [] else self.log[last_i][0]

            # print("SRC_LAST_I", src_last_i)
            # print("LAST_I", last_i)
            # print("SRC LAST TERM", src_last_term)
            # print("LAST_TERM", last_term)
            if src_last_i < last_i or src_last_term < last_term:
                valid = False

            if valid:
                self.election = True
                self.leader_id = BROADCAST
                self.timer_start = time.time()

            votemsg = {
                "src": self.id,
                "dst": src,
                "leader": BROADCAST if valid else self.leader_id,
                "type": "vote",
                "term": self.term,
                "vote": 'true' if valid else 'false',
                "cand_id": src,
            }

            self.send(votemsg)
            self.voted = valid
            
    # if candidate, parse the vote we received
    def got_vote(self, msg):
        if self.state == State.LEADER:
            return # already leader, ignore
        voter = msg['src']

        if msg['vote'] == 'true' and (voter not in self.my_voters):
            self.my_voters.append(voter)
            # if we have a majority, we are now the leader
            if len(self.my_voters) >= 3:
                # print('\n\n LEADER IS', self.id)
                self.state = State.LEADER
                self.leader_id = self.id
                self.voted = False
                self.election = False
                self.my_voters = []

                now = time.time()
                ll = len(self.log)
                self.timers = [now,now,now,now,now]
                self.nextIndex = [ll,ll,ll,ll,ll]

                # start heartbeat as new leader
                # self.send_append_entries(heartbeat = True)
                self.ae_loop(heartbeat = True)
                self.handleElectionQueue()  # go through backlog messages that happened during the election
        
        # if we got rejected, its possible our term was out of date
        elif msg['vote'] == 'false' and msg['term'] > self.term:
            self.term = msg['term']

    # if not the leader, monitor leader timeout
    def check_timeout(self):
        if time.time() > (self.timer_start + self.TIMEOUT):
            if self.state == State.FOLLOWER:
                print('\n\n LEADER DIED')
            if self.state == State.CANDIDATE:
                print('\n\n ELECTION TIMED OUT')
            # print('\nREQUESTING VOTE ')
        else:
            return

        # become a candidate, increment our term, send RequestVote
        self.leader_id = BROADCAST
        self.state = State.CANDIDATE
        self.term += 1
        self.election = True

        last_i = len(self.log) - 1
        last_term = -1 if self.log == [] else self.log[last_i][0]

        rv = { 
            "src": self.id, 
            "dst": BROADCAST, 
            "leader": BROADCAST,
            "type": "rv", 
            "term": self.term, 
            "last_i": last_i,         # index of last log entry
            "last_term": last_term    # term of that entry
        }
        self.voted = True
        self.my_voters = [self.id]
        self.TIMEOUT = random.randrange(150, 300) / 1000
        self.timer_start = time.time()
        self.send(rv)
            

    # if leader, monitor heartbeat based on timer for each follower
    def check_heartbeat(self):
        for i, t in enumerate(self.timers):
            str_id = "000" + str(i)
            if str_id != self.id and (time.time() > (t + HEARTBEAT_PERIOD)):
                self.send_append_entries(heartbeat = True, follower_id = str_id)

    ##################################################################################################
    # AppendEntries Logic

    # loop for sending appendEntries RPCs to followers
    def ae_loop(self, heartbeat = False):
        # print('ae_loop')
        # check which followers need new entries, based on their nextIndex
        for str_id in REPLICAS:
            if str_id != self.id:
                int_id = int(str_id)
                if len(self.log) > self.nextIndex[int_id]:
                    self.send_append_entries(heartbeat, str_id)


    # inform followers of new log entries via AppendEntries RPC
    def send_append_entries(self, heartbeat, follower_id):
        int_fid = int(follower_id)
        nextI = self.nextIndex[int_fid]
        # print("sending ae to replica with nextI of %s" % nextI)
        prev_log_i = nextI - 1
        prev_log_term = -1 if (len(self.log) <= 1) else self.log[prev_log_i][0]     
        
        # here are the entries you should append to your log
        entries = [] if self.log == [] else self.log[nextI:nextI+1] 

        ae = {
            "src": self.id, 
            "dst": follower_id,
            "leader": self.id,
            "type": "ae",
            "term": self.term,
            "prev_log_i": prev_log_i,
            "prev_log_term": prev_log_term,
            "entries": [] if heartbeat else entries, 
            "commitIndex": self.commitIndex # everything thru commitIndex should be committed to your db
            }   

        self.send(ae)
        self.timers[int_fid] = time.time()


    # logic for receiving an appendEntries RPC
    def got_append_entries(self, msg):
        self.timer_start = time.time()
        leader = msg["src"]
        entries = msg["entries"]
        leader_term = int(msg["term"])
        leader_commitIndex = int(msg["commitIndex"])

        # if this is a new leader
        if self.leader_id == BROADCAST or self.state == State.LEADER or self.leader_id != leader:
            print('\n NEW LEADER')
            self.state = State.FOLLOWER
            self.leader_id = leader
            self.voted = False
            self.election = False
            self.term = leader_term
            self.my_voters = [] 
            self.handleElectionQueue() # go through backlog messages that happened during the election
        
        # if not just a heartbeat
        if entries != []:
            # print('\nGOT AE')
            valid = True

            # 1. Reply false if term < currentTerm (§5.1)
            if leader_term < self.term:
            #    print('\ninvalid -- term')
               valid = False

            prev_log_i = int(msg["prev_log_i"])
            prev_log_term = int(msg["prev_log_term"]) # -1 if leaders log len < 2

            # 2. Reply false if log doesn’t contain an entry at prevLogIndex whose term matches prevLogTerm (§5.3)
            if prev_log_i != -1: # if not the very first entry
                # if our log has something at that spot
                if prev_log_i <= len(self.log) - 1:
                    if self.log[prev_log_i][0] != prev_log_term: # make sure the terms are same
                        # print('\ninvalid -- prev log term')
                        valid = False

            if valid:
                self.log.append(entries[0])
                self.update_follower_db(msg)
                self.commitIndex = msg["prev_log_i"] + 1
            
            self.reply_to_ae(msg, valid)


    # log follower commits to their state machine 
    def update_follower_db(self, msg):
        if self.state != State.FOLLOWER:
            return
        entries = msg["entries"]
        self.data[entries[0][1]] = entries[0][2]
        self.commitIndex = msg["prev_log_i"] + 1


    # followers response message to an append entries rpc
    def reply_to_ae(self, msg, valid):
        ae_res = { 
            "src": self.id, 
            "dst": self.leader_id, 
            "leader": self.leader_id,
            "type": "ae_res",
            "term": self.term,
            "index": msg["prev_log_i"],
            "success": "true" if valid else "false",
            "nextI": len(self.log),
            }
        self.send(ae_res)


    # handle success or failure response from follower after an appendEntries RPC
    def got_ae_res(self, msg):
        f_id = int(msg["src"])
        newNextIndex = int(msg['nextI'])
        success = True if msg["success"] == "true" else False
        index = msg['index']

        if success:
            if newNextIndex > self.nextIndex[f_id]:
                self.nextIndex[f_id] = newNextIndex
                print('\n\nupdated nextIndex arr:', self.nextIndex)

            if index == self.commitIndex:
                self.successes += 1
                if self.successes >= 2:
                    # print('\n\nGOT MAJORITY, committing index', self.commitIndex)

                    # grab the most recent entry, commit to data dict
                    entry = self.log[len(self.log) - 1]
                    self.data[entry[1]] = entry[2] 

                    # tell the client we've committed their put()
                    put_ok = {
                        "src": self.id, 
                        "dst": self.curr_client,
                        "leader": self.id, 
                        "type": "ok", 
                        "MID": self.curr_mid,
                        }
                    self.send(put_ok)
                    self.commitIndex += 1
                    self.awaiting_majority = False
                    self.successes = 0  # reset successes counter

                    # if more put()s are in the queue
                    if self.puts_queue != []:
                        next_put_msg = self.puts_queue[0]
                        self.puts_queue.remove(next_put_msg)
                        self.handle_put(next_put_msg) 

        elif not success:
            # TODO: otherwise decrement index and try again
            # print("\n\n AE REJECTED")
            return
        

    def handleElectionQueue(self):
        # print('\n\nHANDLING ELECTION QUEUE')
        # print('i have ' + str(len(self.election_queue)) + ' things in my election queue')
        for msg in self.election_queue:
            self.handle_leader_command(msg)
        self.election_queue = []

    ##################################################################################################
    # PUT AND GET LOGIC:

    # perform leader response to client or redirect
    def handle_leader_command(self, msg):
        if self.state != State.LEADER:
            self.send_redirect(msg)
        elif msg["type"] == "get":
            self.handle_get(msg)
        elif msg["type"] == "put":
            self.handle_put(msg)
        else:
            print("invalid message")


    # follower logic for redirecting client requests
    def send_redirect(self, msg):
        # print('\n REDIRECT. TELLING CLIENT ABOUT LEADER')
        redirect = {
            "src": self.id, 
            "dst": msg["src"],
            "leader": self.leader_id,
            "type": "redirect",
            "MID": msg['MID']
            }
        self.send(redirect)


    #  leader logic for informing replicas about put() from client
    def handle_put(self, msg):
        # print('\n\n LEADER GOT PUT()')
        # print('\n\n SENDING OUT TO FOLLOWERS')
        # if we have not yet responded to the current put(), add this put() to queue
        if self.awaiting_majority:
            # print('\n\n WAITING FOR MAJORITY. PUTTING IN PUTS QUEUE')
            self.puts_queue.append(msg)
        else:
            k = msg["key"]
            v = msg["value"]
            if [k, v] != self.curr_k_v:
                # 1. keep track of MID and client for our response
                self.curr_mid = msg['MID']
                self.curr_client = msg['src']
                self.curr_put = msg

                # 2. form the new log entry
                entry = [self.term, msg["key"], msg["value"]]
                self.log.append(entry)

                # 3. inform replicas, wait for majority successes
                self.ae_loop(heartbeat=False)
                self.awaiting_majority = True
                self.put_timer = time.time()
                self.curr_k_v = [k, v] # necessary?
        

    # leader logic for replying to a get()
    def handle_get(self, msg):
        val = self.data[msg["key"]] if msg["key"] in self.data.keys() else ""
        get_res = {
            "src": self.id, 
            "dst": msg["src"], 
            "leader": self.id, 
            "type": "ok", 
            "MID": msg["MID"],
            "value": val
            }
        self.send(get_res)

    ##################################################################################################

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='run a key-value store')
    parser.add_argument('port', type=int, help="Port number to communicate")
    parser.add_argument('id', type=str, help="ID of this replica")
    parser.add_argument('others', metavar='others', type=str, nargs='+', help="IDs of other replicas")
    args = parser.parse_args()
    replica = Replica(args.port, args.id, args.others)
    replica.run()
