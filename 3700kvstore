    def run(self):
        while True:
            incoming, outgoing, exceptional = select.select([self.socket], [self.socket], [self.socket])
            for reader in incoming:
                if reader is self.socket:
                    # recv
                    data, addr = self.socket.recvfrom(65535)
                    msg = json.loads(data.decode('utf-8'))
                    print("Received message '%s'" % (data.decode('utf-8'),), flush=True)
                    mtype = msg['type']
                    src = msg['src']

                    # Does this logic also go within here? it involves send()s ....

                    # handle a requestVote RPC
                    if mtype == "rv":
                        self.got_request_vote(msg)

                    # handle a vote
                    if mtype == "vote" and self.state == State.CANDIDATE:
                        self.got_vote(msg)

                    # handle an appendEntries RPC
                    if mtype == 'ae':
                        self.got_append_entries(msg)

                    # handle client put/get
                    if mtype == 'put':
                        self.handle_put(msg)

                    # handle client put/get
                    if mtype == 'get':
                        self.handle_get(msg)

                    if mtype == 'ae_res':
                        self.got_ae_res(msg)

            for writer in outgoing:
                if writer is self.socket:
                    # send logic
                    # Check for various timeouts, depending on state
                    if self.state != State.LEADER:
                        self.check_timeout()
                    if self.state == State.LEADER:
                        self.check_heartbeat()

    def got_ae_res(self, msg):
        # if success
        success = msg["success"]
        index = msg["index"]
        if success and index == self.commitIndex:
            self.successes += 1
            if self.successes >= 3:
                print('GOT ALL SUCCESSES, committing index', self.commitIndex)
                self.commitIndex += 1
                self.sendOK()
                self.awaiting_majority = False
                self.successes = 0  # reset successes counter
                if self.puts_queue != []:
                    self.send_append_entries(index_of_entry = self.puts_queue[0]) # send first in queue
                    self.puts_queue.pop(0) # remove from queue
                    self.awaiting_majority = True
        else:
            # otherwise decrement index and try again
            return

    def sendOK(self):
        ok = {
            "src": self.id,
            "dst": self.currentPutMsg['src'],
            "leader": self.leader_id,
            "type": "ok",
            "MID": self.currentPutMsg['MID'],
            "index": msg["prev_log_i"],
            "success": "true" if valid else "false"
        }


    def handle_put(self, msg):
        # if client doesn't know who leader is
        if msg['leader'] == BROADCAST or msg['leader'] != self.leader_id:
            print('\n REDIRECT. TELLING CLIENT ABOUT LEADER')
            redirect = {
                "src": self.id, 
                "dst": msg["src"],
                "leader": self.leader_id,
                "type": "redirect", 
                "MID": msg['MID']
                }
            self.send(redirect)
            return
        # otherwise, if we are the leader, append to log and send appendEntries to followers
        if msg['leader'] == self.leader_id and self.state == State.LEADER:
            print('\n LEADER GOT PUT')
            entry = [self.term, msg["key"], msg["value"]]
            self.currentPutMsg = msg
            self.log.append(entry)
            print('\n LOG IS NOW : ', self.log)
            if not self.awaiting_majority:
                self.send_append_entries(index_of_entry = len(self.log) - 1)
                self.awaiting_majority = True
            else:
                self.puts_queue.append(len(self.log) - 1)

