BROADCAST = "FFFF"
HEARTBEAT_PERIOD = .140 # leader should send heartbeat every 140ms
REPLICAS = 5
# TIMEOUT_RANGE = [150, 300, 30]  # replicas will have a randomly assigned timeout from this fixed interval, staggered by 30

class State(enum.Enum):
    FOLLOWER = 0
    CANDIDATE = 1
    LEADER = 2

class Replica:
    term = 0
    state = State.FOLLOWER
    log = []        # list of lists, where each is an entry in the form [term, k, v]
    data = {}     # dict of (k, v) pairs
    leader_id = BROADCAST
    timer_start = 0

    my_voters = []              # our votees (if we are a candidate)
    voted_for = None            # candidate we voted for
    TIMEOUT = None    # our randomly assigned timeout threshold within [150, 300]

    # leader fields:
    time_last_msg_sent = None  # time since our last message (heartbeat or get/put)
    nextIndexes = [0,0,0,0,0]
    commitIndex = -1
    puts_queue = []
    successes = 0
    awaiting_majority = False
    # MIDs = {}
    curr_k_v = [None, None]
    curr_mid = None
    curr_client = None

    def __init__(self, port, id, others):
        self.port = port
        self.id = id
        self.others = others

        self.socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.socket.bind(('localhost', 0))

        print("Replica %s starting up" % self.id, flush=True)
        hello = { "src": self.id, "dst": BROADCAST, "leader": BROADCAST, "type": "hello" }
        self.send(hello)
        #print("Sent hello message: %s" % hello, flush=True)

        # assign self a timeout threshold in 150–300ms
        self.TIMEOUT = random.randrange(150, 300) / 1000 #threshold needs to be ms not s
        print('\nfor ' + str(self.id) + ' timeout is ' + str(self.TIMEOUT))

        self.timer_start = time.time() 
        self.time_last_msg_sent = time.time()
        print('timer start', self.timer_start)

    def send(self, message):
        print("Sent message: %s" % message, flush=True)
        self.socket.sendto(json.dumps(message).encode('utf-8'), ('localhost', self.port))

    # recieved a RequestVote RPC
    def got_request_vote(self, json_msg):
        src = json_msg['src']
        valid = True

        # is their term >= ours?
        if json_msg['term'] < self.term:
            valid = False
            print('false term')

        # is their log up to date with ours?
        src_last_i = json_msg['last_i']
        src_last_term = json_msg['last_term'] # term of last thing in log

        if self.term == 0 or self.term == 1:
            last_term = 0
        else:
            last_term = self.log[len(self.log) - 1][0]

        if src_last_term < last_term:
            valid = False
            print('false term')
        if src_last_i < len(self.log) - 1:
            valid = False
            print('false index')
        
        # have we already voted?
        if self.voted_for is not None:
            valid = False
            print('already voted')

        vote = 'true' if valid else 'false'

        votemsg = { 
            "src": self.id, 
            "dst": src,
            "leader": BROADCAST, 
            "type": "vote", 
            "vote": vote,
            "cand_id": src, 
        }
        self.voted_for = src
        self.send(votemsg)

    def last_log_term(self):
        return self.log[len(self.log) - 1][0]

    # if we arent the leader, check whether the leader has died
    def check_timeout(self):
        if time.time() > (self.timer_start + self.TIMEOUT) and self.state == State.FOLLOWER:
            if self.leader_id == BROADCAST: print('\n\nELECTING LEADER')
            else: print('\n\n LEADER DIED')

            print(str(self.id) + ' sending requestvote')
            # send RequestVote RPC
            self.term += 1
            last_term = 0 if self.log == [] else self.last_log_term()
            rv = { 
                "src": self.id, 
                "dst": BROADCAST, 
                "leader": BROADCAST,
                "type": "rv", 
                "term": self.term, 
                "last_i": len(self.log) - 1, # index of last thing in log 
                "last_term": last_term # term of last thing in log
            }
            self.voted_for = self.id
            self.send(rv)
            self.leader_id = BROADCAST
            self.state = State.CANDIDATE
            self.my_voters = [self.id]
            # reset timer for the election
            # self.TIMEOUT = random.randrange(150, 300)
            print('starting election timer')
            self.timer_start = time.time()
            
        if time.time() > (self.timer_start + self.TIMEOUT) and self.state == State.CANDIDATE:
            print('election timed out')

    # if we are the leader, check whether we need to send a heartbeat message
    def check_heartbeat(self):
        if time.time() > (self.time_last_msg_sent + HEARTBEAT_PERIOD):
            # print('leader ' + str(self.id) + ' sending heartbeat')
            self.send_append_entries(heartbeat = True)

    def getterm(self, entry):
        if entry:
            return entry[0] # term lives at index 0
        else:
            return -1

    # send AppendEntries RPCs to all replica followers
    def send_append_entries(self, heartbeat = False):
        prev_log_i = -1 if len(self.log) < 2  else len(self.log) - 2   # index of entry imm preceding new ones .. 
        print('\n\nin send_append_entries, prev_log_i =', prev_log_i)
        prev_log_term = -1 if len(self.log) < 2 else self.getterm(self.log[prev_log_i]) # term of prev_log_i
        entries = [] if self.log == [] else self.log[prev_log_i+1:]  # everything after prev_log_i in the log

        if entries:
            self.currentPutKey = entries[0][1] # term, key, value
        ae = { 
            "src": self.id, 
            "dst": BROADCAST, 
            "leader": self.id,
            "type": "ae",
            "term": self.term,
            "prev_log_i": prev_log_i, # if log = [], prev_log_i = -1
            "prev_log_term": prev_log_term, # if log = [], prev_log_term = -1
            "entries": [] if heartbeat else entries, 
            "commit": self.commitIndex
            }
        self.time_last_msg_sent = time.time()
        self.send(ae)

    # if we are a candidate, parse the vote someone casted for us
    def got_vote(self, msg):
        if self.state == State.LEADER:
            return # already leader
        vote = msg['vote']
        src = msg['src']
        if vote == 'true' and (src not in self.my_voters):
            self.my_voters.append(src)
            # if we have a majority, we are now the leader
            if len(self.my_voters) >= 3:
                print('\n\n LEADER IS', str(self.id))
                self.state = State.LEADER
                self.leader_id = self.id
                self.voted_for = None
                self.send_append_entries(heartbeat = True)
        # else? do we need to do something if someone doesnt vote for us


